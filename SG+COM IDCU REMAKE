-- -------------------------------------------
-- FLING LOGIC  (1.5 seconds = 30 x 0.05 s)
-- -------------------------------------------
local isFLinging = false

local function executeFling(speed, label)
    if isFLinging then return end
    isFLinging = true

    local char = player.Character
    if not (char and char:FindFirstChild("HumanoidRootPart")) then
        isFLinging = false
        return
    end
    local hrp = char.HumanoidRootPart

    task.spawn(function()
        for i = 1, 30 do
            -- Countdown: 1.5 to 0.1
            local remaining = math.ceil((30 - i + 1) * 0.05 * 10) / 10
            StatusLabel.Text = ("> %s  [%.1fs]"):format(label, remaining)
            StatusLabel.TextColor3 = C.accent1

            if not (char and hrp and hrp.Parent) then break end
            hrp.RotVelocity = Vector3.new(speed, speed, speed)
            hrp.Velocity    = camera.CFrame.LookVector * speed
            task.wait(0.05)
        end

        if hrp and hrp.Parent then
            hrp.RotVelocity = Vector3.zero
        end

        StatusLabel.Text      = "- IDLE -"
        StatusLabel.TextColor3 = C.muted
        isFLinging = false
    end)
end


-- -------------------------------------------
-- HELPERS
-- -------------------------------------------
local function make(class, parent, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function tween(obj, info, props)
    TweenService:Create(obj, info, props):Play()
end

